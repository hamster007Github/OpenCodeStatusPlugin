{
  "name": "opencode-status-plugin",
  "version": "0.1.0",
  "description": "OpenCode Go provider health inside OpenCode Desktop and the CLI: a composer pill, a side panel, a settings page and a terminal footer.",
  "type": "module",
  "license": "MIT",
  "author": "OpenCodeStatusPlugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamster007Github/OpenCodeStatusPlugin.git"
  },
  "homepage": "https://github.com/hamster007Github/OpenCodeStatusPlugin#readme",
  "bugs": {
    "url": "https://github.com/hamster007Github/OpenCodeStatusPlugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-go",
    "status",
    "health",
    "tui"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./tui": "./src/tui.tsx",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check:api": "bun scripts/api-contract.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.0",
    "@opentui/solid": ">=0.8.0",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opentui/core": "^0.8.3",
    "@opentui/solid": "^0.8.3",
    "@types/bun": "^1.4.4",
    "effect": "4.0.6",
    "solid-js": "^1.9.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-solid": "^2.11.15"
  },
  "publishConfig": {
    "access": "public"
  }
}
