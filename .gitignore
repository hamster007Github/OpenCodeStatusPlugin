# Version the reusable shell and the plugin source only; everything else stays local.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/README.md
!/AGENTS.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/opencode.jsonc

# Reference documentation: the feed contract and the release runbook.
!/docs/

!/.claude/
/.claude/*
!/.claude/skills/

# GitHub metadata: workflows, issue forms and the pull request template.
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
!/.github/workflows/
!/.github/PULL_REQUEST_TEMPLATE.md
!/.github/CODEOWNERS

# The plugin itself: source, tests and the files its build needs.
!/src/
!/test/
!/scripts/
!/package.json
!/bun.lock
!/tsconfig.json
!/vite.config.ts

local/
node_modules/
dist/
__pycache__/
*.py[cod]
.venv/
*.log
*.env
*.env.*
.DS_Store
Thumbs.db
desktop.ini
